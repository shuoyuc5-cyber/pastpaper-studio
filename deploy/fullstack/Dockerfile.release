FROM python:3.14-slim-trixie@sha256:9aaa474097d094040649f2162a627c0049b408f52138d980916788d80f04802f AS python-base
RUN sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources \
 && printf 'Acquire::Retries "2";\nAcquire::https::Timeout "25";\n' > /etc/apt/apt.conf.d/99studio-fetch

FROM python-base AS web-security
# Fetch the signed Debian update in a stage with CA certificates.
WORKDIR /security
RUN apt-get --error-on=any update && apt-get download zlib1g

FROM node:24-trixie-slim@sha256:af02d57b57719b9657a45199a79264a9437940cd55b3c7b3fc99615654f124a0 AS web-build
WORKDIR /studio
COPY frontend/package*.json ./
RUN npm ci --no-audit
COPY frontend/ ./
ENV NEXT_TELEMETRY_DISABLED=1 PASTPAPER_PUBLIC_ORIGIN=https://build.example.org
RUN npm run build && npm prune --omit=dev --no-audit

FROM node:24-trixie-slim@sha256:af02d57b57719b9657a45199a79264a9437940cd55b3c7b3fc99615654f124a0 AS web
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
WORKDIR /studio
COPY --from=web-build /studio/.next ./.next
COPY --from=web-build /studio/public ./public
COPY --from=web-build /studio/node_modules ./node_modules
COPY frontend/server-public.cjs frontend/client-access.cjs ./
RUN --mount=from=web-security,source=/security,target=/tmp/security \
    dpkg -i /tmp/security/zlib1g_*.deb \
 && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' zlib1g)" ge '1:1.3.dfsg+really1.3.1-1+deb13u1' \
 && rm -rf /usr/local/lib/node_modules /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack
USER 10001:10001
CMD ["node","server-public.cjs"]

FROM python-base AS ocr-build
RUN apt-get update && apt-get install -y --no-install-recommends cmake g++ make pkg-config libleptonica-dev libtiff-dev
ADD --checksum=sha256:a8dbf8b8c8ee427ff6ad1d99116502feaf59440af1adb893caf60a6576826cf4 https://codeload.github.com/tesseract-ocr/tesseract/tar.gz/refs/tags/5.5.4 /tmp/tesseract.tar.gz
# Only local raster input and packaged language models are needed by the OCR workers.
RUN mkdir /src && tar -xf /tmp/tesseract.tar.gz -C /src --strip-components=1 \
 && cmake -S /src -B /build -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_DATAROOTDIR=share/tesseract-ocr/5 \
      -DCMAKE_CXX_FLAGS='-DTESSDATA_PREFIX=\"/usr/share/tesseract-ocr/5\"' \
      -DBUILD_SHARED_LIBS=OFF -DBUILD_TRAINING_TOOLS=OFF -DOPENMP_BUILD=ON -DDISABLE_ARCHIVE=ON -DDISABLE_CURL=ON \
 && cmake --build /build --target tesseract --parallel 3 \
 && DESTDIR=/install cmake --install /build --strip \
 && mkdir -p /pkg/DEBIAN /pkg/usr/bin /pkg/usr/share/doc/tesseract-ocr \
 && cp /install/usr/bin/tesseract /pkg/usr/bin/ \
 && cp -a /install/usr/share/tesseract-ocr /pkg/usr/share/ \
 && cp /src/LICENSE /pkg/usr/share/doc/tesseract-ocr/copyright \
 && printf 'Package: tesseract-ocr\nVersion: 5.5.4-0pastpaper1\nSource: tesseract\nArchitecture: %s\nMaintainer: PastPaper Studio\nDepends: libleptonica6, libtiff6, libgomp1, libstdc++6\nDescription: Tesseract OCR CLI for local raster input\n' "$(dpkg --print-architecture)" > /pkg/DEBIAN/control \
 && dpkg-deb --root-owner-group --build /pkg /tmp/tesseract-ocr.deb

FROM python-base AS backend
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PASTPAPER_DATA_DIR=/state PASTPAPER_BACKEND_PORT=8000
WORKDIR /studio
RUN --mount=from=ocr-build,source=/tmp/tesseract-ocr.deb,target=/tmp/tesseract-ocr.deb \
    apt-get update && apt-get upgrade -y \
 && apt-get install -y --no-install-recommends libseccomp2 /tmp/tesseract-ocr.deb tesseract-ocr-eng tesseract-ocr-chi-sim tesseract-ocr-osd \
 && ldd /usr/bin/tesseract > /tmp/ocr-libraries \
 && ! grep -E 'libxml2|libarchive|libcurl|not found' /tmp/ocr-libraries \
 && rm /tmp/ocr-libraries \
 && tesseract --list-langs > /tmp/ocr-languages \
 && grep -Fx eng /tmp/ocr-languages && grep -Fx chi_sim /tmp/ocr-languages && grep -Fx osd /tmp/ocr-languages \
 && rm /tmp/ocr-languages \
 && rm -rf /var/lib/apt/lists/* \
 && install -d -m 0700 -o 10001 -g 10001 /state /capture
COPY backend/requirements-lock.txt ./backend/
RUN pip install --no-cache-dir -r backend/requirements-lock.txt && pip check \
 && python -m pip uninstall -y pip \
 && rm -rf /usr/local/lib/python3.14/ensurepip
COPY backend/app ./backend/app
COPY scripts/public_service.py scripts/audit_backup.py scripts/verify_public_storage.py scripts/monitor_public.py ./scripts/
USER 10001:10001
CMD ["python","-m","uvicorn","--app-dir","backend","app.main:app","--host","127.0.0.1","--port","8000","--no-proxy-headers","--no-access-log","--timeout-keep-alive","15"]
