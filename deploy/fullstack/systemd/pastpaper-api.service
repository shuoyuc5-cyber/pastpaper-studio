[Unit]
Description=PastPaper Studio api
After=network.target

[Service]
Type=simple
User=pastpaper
Group=pastpaper
EnvironmentFile=/etc/pastpaper/fullstack.env
WorkingDirectory=/opt/pastpaper/current
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictSUIDSGID=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
CapabilityBoundingSet=
Restart=on-failure
RestartSec=3
ExecStart=/opt/pastpaper/current/backend/.venv/bin/python -m uvicorn --app-dir backend app.main:app --host 127.0.0.1 --port 8000 --no-proxy-headers --no-access-log --timeout-keep-alive 15
ReadWritePaths=/var/lib/pastpaper/data
MemoryMax=1500M
TasksMax=128

[Install]
WantedBy=multi-user.target
