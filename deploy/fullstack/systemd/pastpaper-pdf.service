[Unit]
Description=PastPaper Studio PDF worker
After=network.target

[Service]
Type=simple
User=pastpaper
Group=pastpaper
EnvironmentFile=/etc/pastpaper/fullstack.env
WorkingDirectory=/opt/pastpaper/current
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictSUIDSGID=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
CapabilityBoundingSet=
Restart=on-failure
RestartSec=3
ExecStart=/opt/pastpaper/current/backend/.venv/bin/python scripts/public_service.py pdf-worker
ReadWritePaths=/var/lib/pastpaper/data
PrivateNetwork=yes
InaccessiblePaths=/etc/pastpaper/secrets
RestrictAddressFamilies=AF_UNIX
CPUQuota=100%
MemoryMax=900M
TasksMax=64
KillMode=mixed
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
