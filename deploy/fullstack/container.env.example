# Keep the actual file outside the checkout. This example is for synthetic staging.
PASTPAPER_PUBLIC_ORIGIN=https://staging.example.org
PASTPAPER_ADMIN_TOTP_FILE=/run/studio-secrets/admin-totp
PASTPAPER_MAIL_KEY_FILE=/run/studio-secrets/mail-fernet
PASTPAPER_TEST_MAIL_DIR=/capture
PASTPAPER_SYNTHETIC_MAIL_CAPTURE=1
PASTPAPER_MAIL_FROM=no-reply@example.test
