# Copy this template to /etc/pastpaper/fullstack.env on a dedicated Linux host.
# Set the same HTTPS origin in data/.pastpaper-public before initial bootstrap.
PASTPAPER_PUBLIC_ORIGIN=https://staging.example.org
PASTPAPER_DATA_DIR=/var/lib/pastpaper/data
PASTPAPER_WEB_PORT=3000
PASTPAPER_BACKEND_PORT=8000
PASTPAPER_MAIL_FROM=notifications@example.org
PASTPAPER_SMTP_HOST=smtp.example.org
PASTPAPER_SMTP_USER=notifications@example.org
PASTPAPER_SMTP_PASSWORD_FILE=/etc/pastpaper/secrets/smtp-password
PASTPAPER_MAIL_KEY_FILE=/etc/pastpaper/secrets/mail-fernet
PASTPAPER_ADMIN_TOTP_FILE=/etc/pastpaper/secrets/admin-totp
NEXT_TELEMETRY_DISABLED=1
# For restricted synthetic staging only. Create a 0700 capture directory on this VM.
# PASTPAPER_SYNTHETIC_MAIL_CAPTURE=1
# PASTPAPER_TEST_MAIL_DIR=/var/lib/pastpaper/data/test-mail
# PASTPAPER_MAIL_FROM=no-reply@example.test
