# Legacy LAN migration only; keep at 0 for device-first visitor privacy.
PASTPAPER_LEGACY_GUEST_WRITES=0
# PASTPAPER_DATA_DIR=/absolute/path/to/owner-controlled-data
# Keep the backend bound to 127.0.0.1. Local test defaults are intentionally private.
PASTPAPER_HOST_LAN=0
PASTPAPER_LAN_ONLY=1
# Set this to 1 when starting behind the independent HTTPS entrypoint.
PASTPAPER_REQUIRE_HTTPS=0
# Cloudflare submission and moderation secrets belong in Wrangler secret storage.
